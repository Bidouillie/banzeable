{% extends 'base.html.twig' %}

{% block title %}Add course{% endblock %}

{% block body %}
<style>
    .example-wrapper {
        margin: 1em auto;
        max-width: 800px;
        width: 95%;
        font: 18px/1.5 sans-serif;
    }

    .example-wrapper code {
        background: #F5F5F5;
        padding: 2px 6px;
    }
</style>

<div class="example-wrapper">
    <h1>Add course</h1>

    {{ form_start(form) }}
    {{ form_widget(form) }}
    <button type="submit" class="btn btn-primary">Submit</button>
    {{ form_end(form) }}
    {% if delete_form is not null %}
        {{ form_start(delete_form) }}
        <button type="submit" class="btn btn-danger">Delete</button>
        {{ form_row(delete_form._token) }}
        {{ form_end(delete_form, {'render_rest': false}) }}
    {% endif %}
</div>
{% endblock %}
{% extends 'base.html.twig' %}

{% block title %}Add variation{% endblock %}

{% block body %}
<style>
    .example-wrapper {
        margin: 1em auto;
        max-width: 800px;
        width: 95%;
        font: 18px/1.5 sans-serif;
    }

    .example-wrapper code {
        background: #F5F5F5;
        padding: 2px 6px;
    }
</style>

<div class="example-wrapper">
    <h1>Add variation</h1>

    {{ form_start(form) }}
    {{ form_row(form.name, {label: 'Name'}) }}
    {{ form_row(form.blackOrientation, {label: 'Orientation'}) }}
    {{ form_row(form.course, {label: 'Course'}) }}
    {{ form_row(form.PGN, {label: 'PGN'}) }}
    <button type="submit" class="btn btn-primary">Submit</button>
    {{ form_row(form._token) }}
    {{ form_end(form, {'render_rest': false}) }}
</div>
{% endblock %}
{% extends 'base.html.twig' %}

{% block title %}Hello VariationController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Variations</h1>

    <ul>
        {% for variation in variations %}
        <div class="card mb-1">
            <div class="card-body">
                <div class="card-title d-flex justify-content-between">
                    <a href="{{ path('app_admin_variation_show', {id: variation.id}) }}" class="stretched-link link-dark">
                        <h4 class="mb-1">{{ variation.name }}</h4>
                    </a>
                    <small class="text-muted">Identifiant : {{ variation.id }}</small>
                </div>
            </div>
        </div>
        {% endfor %}
    </ul>
</div>
{% endblock %}

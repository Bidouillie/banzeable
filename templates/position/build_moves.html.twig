
<turbo-stream action="update" target="course_build-moves_{{ course.id }}_title">
    <template>
        {% if my_turn %}Choose your move{% else %}Choose a move to prepare for{% endif %}
    </template>
</turbo-stream>

<turbo-stream action="update" target="course_build-moves_{{ course.id }}_body">
    <template>
        <div id="build_moves" class="tw-grid tw-grid-cols-12 tw-gap-7 tw-p-2" data-can-save="{{ can_save|json_encode }}" data-moves-whole="{{ moves_whole|json_encode }}" data-missing-percentages="{{ missing_percentages|map(p => p|number_format(5))|json_encode }}" data-diverge-index="{{ diverge_index|json_encode }}" data-merge-index="{{ merge_index|json_encode }}">
            <div class="{{ my_turn ? 'tw-col-span-2' : 'tw-col-span-2' }}">Move</div>
            {% if not my_turn %}
                <div class="tw-col-span-3">Coverage</div>
            {% endif %}
            <div class="{{ my_turn ? 'tw-col-span-4' : 'tw-col-span-2' }}">{% if my_turn %}Masters{% else %}Expected{% endif %}</div>
            <div class="tw-col-span-1">Eval</div>
            <div class="{{ my_turn ? 'tw-col-span-5' : 'tw-col-span-4' }}">Peer results</div>
        </div>
        
        <div id="build_moves_data" class="d-none"></div>
        
        {% for move_stat in candidate_move_stats %}
            {% set move = move_stat.move %}
            {% set popularity = move_stat.popularity %}
            {% set expected = my_turn ? move_stat.selectedPercentageMasters : move_stat.expectedPercentage %}
            <a href="#" class="list-group-item list-group-item-action build_moves {% if not move_stat.show ?? false and not move_stat.saved ?? false %}d-none{% endif %}" data-san="{{ move.san }}" data-lan="{{ move.lan }}" data-saved="{{ move_stat.saved }}" data-reached="{{ not move_stat.saved and (move_stat.position ?? null) is not null }}" {% if (move_stat.expectedPercentage ?? null) is not null %}data-expected="{{ (move_stat.position ?? null) is not null ? move_stat.position.expectedPercentage : move_stat.expectedPercentage }}"{% endif %} onclick="return false">
                <div class="tw-grid tw-grid-cols-12 tw-gap-7 tw-items-center">
                    <div class="{{ my_turn ? 'tw-col-span-2' : 'tw-col-span-2' }} tw-flex tw-items-center">{{ move.san }}{% if move_stat.saved %} ✅{% elseif (move_stat.position ?? null) is not null %} 🎯{% endif %}</div>
                    {% if not my_turn %}
                        <!--div class="tw-col-span-1 tw-flex tw-items-center">
                            {{ ((move_stat.selectedPercentage ?? null) is not null ? (move_stat.selectedPercentage|format_number(style: 'percent')) : null) }}
                        </div-->
                        <div class="tw-col-span-3 tw-flex tw-items-center">
                        {% if move_stat.saved and (move_stat.position ?? null) is not null %}
                            <div class="progress tw-grow" style="height: 7px">
                                <div class="progress-bar bg-info" style="width:{{ (move_stat.position.completion * 100)|round }}%"></div>
                            </div>
                        {% endif %}
                        </div>
                    {% endif %}
                    <div class="{{ my_turn ? 'tw-col-span-4' : 'tw-col-span-2' }} tw-flex tw-items-center">
                        {% if my_turn %}
                            {% if expected is not null %}
                                {% if expected >= 1 / 100 %}
                                    {{ (expected)|format_number(style: 'percent') }}
                                {% elseif expected >= 1 / 1000 %}
                                    &lt;{{ 0.01|format_number(style: 'percent') }}
                                {% elseif expected >= 1 / 10000 %}
                                    &lt;1‰
                                {% elseif expected > 0 %}
                                    &lt;1‱
                                {% else %}
                                    {{ 0|format_number(style: 'percent') }}
                                {% endif %}
                            {% else %}
                                ?
                            {% endif %}
                        {% else %}
                            {% if expected is not null %}
                                {% if expected > 0 %}
                                    1 in {{ (1 / expected)|round }} games
                                {% else %}
                                    1 in ∞ games
                                {% endif %}
                            {% else %}
                                1 in ? games
                            {% endif %}
                        {% endif %}
                    </div>
                    <div class="tw-col-span-1">
                        <div class="tw-flex tw-flex-row tw-rounded-[0.25rem] tw-overflow-hidden">
                            {% set eval = (move_stat.eval ?? null) is null ? null : move_stat.eval|round(1)%}
                            {% if (eval ?? null) is not null %}
                                {% set eval = (move_stat.mate ? '#' : '') ~ (eval == 0 ? '=' : "%+.1f"|format(eval)) %}
                                {% set eval_class = eval >= 0 ? 'text-dark bg-light' : 'text-light bg-dark' %}
                            {% else %}
                                {% set eval = '?' %}
                                {% set eval_class = 'text-dark bg-light'%}
                            {% endif %}
                            <div class="{{ eval_class }}"><small class="tw-px-1 tw-py-1 tw-text-center tw-text-xs tw-font-bold">{{ eval }}</small></div>
                        </div>
                    </div>
                    <div class="{{ my_turn ? 'tw-col-span-5' : 'tw-col-span-4' }}">
                        {% if popularity is not null %}
                            <div class="tw-flex tw-flex-row tw-rounded-[0.25rem] tw-overflow-hidden">
                                <div class="text-dark bg-light" style="width:{{ (popularity.white / popularity.total)|format_number(style: 'percent') }}">
                                    <small class="tw-px-3 tw-py-1">{{ (popularity.white / ((popularity.total)))|format_number(style: 'percent') }}</small>
                                </div>
                                <div class="bg-secondary" style="width:{{ (popularity.draws / popularity.total)|format_number(style: 'percent') }}"><div class="tw-px-3 tw-py-1"></div></div>
                                <div class="text-end text-light bg-dark" style="width:{{ (popularity.black / popularity.total)|format_number(style: 'percent') }}">
                                    <small class="tw-px-3 tw-py-1">{{ (popularity.black / popularity.total)|format_number(style: 'percent') }}</small>
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </a>
        {% endfor %}
    </template>
</turbo-stream>
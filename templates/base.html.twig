<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <title>{% block title %}Welcome!{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">

    {% block javascripts %}
    {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}

    {% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/app.scss') }}">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    {% endblock %}
</head>

<body>

    {% if not (app.request.attributes.get('_route') starts with 'app_admin') %}
    {% set admin = false %}
    {% set menu = [{name: "Courses", routes: [{name: "Browse", route: 'app_course'}, {name: "My courses", route: 'app_my_courses'}, {name: "Studies", route: 'app_studies'}]}, {name: "Test", route: 'app_test'}] %}
    {% else %}
    {% set admin = true %}
    {% set menu = [{name: "Courses", routes: [{name: "List", route: 'app_admin_course'}, {name: "New", route: 'app_admin_course_new'}]}, {name: "Users", routes: [{name: "List", route: 'app_admin_user'}, {name: "New", route: 'app_admin_user_new'}]}, {name: "Variations", routes: [{name: "List", route: 'app_admin_variation'}, {name: "New", route: 'app_admin_variation_new'}]}, {name: "Test", route: 'app_test'}] %}
    {% endif %}

    <div class="toast-container position-fixed bottom-0 end-0 p-3 {% if is_granted('ROLE_ADMIN') %}mb-5{% endif %}">
        <div id="toast" class="toast" role="alert" data-bs-autohide="true" data-bs-delay="1000" aria-live="assertive" aria-atomic="true">
            <!--div class="toast-header">
                <strong class="me-auto">Bootstrap</strong>
                <small>11 mins ago</small>
                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
            </div-->
            <div class="toast-header">
            </div>
            <div class="toast-body" role="button" data-bs-dismiss="toast">
                Hello, world! This is a toast message.
            </div>
        </div>
    </div>

    <nav class="navbar navbar-expand-lg navbar-light bg-light px-3 mb-3">
        <div class="collapse navbar-collapse w-100">
            <a class="navbar-brand" href="#">Banzeable</a>
            <ul class="navbar-nav me-auto">
                {% for menu_item in menu %}
                {% if menu_item.routes is defined %}
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" role="button" aria-expanded="false">
                        {{ menu_item.name }}
                    </a>
                    <ul class="dropdown-menu">
                        {% for dropdown_item in menu_item.routes %}
                        <li><a class="dropdown-item {% if app.request.attributes.get('_route') == dropdown_item.route %}active{% endif %}" href="{{ path(dropdown_item.route) }}">{{ dropdown_item.name }}</a></li>
                        {% endfor %}
                    </ul>
                </li>
                {% else %}
                <li class="nav-item">
                    <a class="nav-link {% if app.request.attributes.get('_route') == menu_item.route %}active{% endif %}" href="{{ path(menu_item.route) }}">{{ menu_item.name }}</a>
                </li>
                {% endif %}
                {% endfor %}
            </ul>
        </div>
        <div class="collapse navbar-collapse w-100">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" role="button" aria-expanded="false">
                        {% if admin %}Admin{% else %}Front{% endif %}
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        {% if admin %}
                        <li><a class="dropdown-item" href="{{ path('app_course') }}">Front</a></li>
                        {% endif %}
                        {% if not(admin) %}
                        <li><a class="dropdown-item" href="{{ path('app_admin_course') }}">Admin</a></li>
                        {% endif %}
                        {% if app.user %}
                        <li><a class="dropdown-item" href="{{ path('app_logout') }}">Logout</a></li>
                        {% else %}
                        <li><a class="dropdown-item {% if app.request.attributes.get('_route') == 'app_register' %}active{% endif %}" href="{{ path('app_register') }}">Register</a></li>
                        <li><a class="dropdown-item {% if app.request.attributes.get('_route') == 'app_login' %}active{% endif %}" href="{{ path('app_login') }}">Login</a></li>
                        {% endif %}
                    </ul>
                </li>
            </ul>
        </div>
    </nav>

    {% block body %}{% endblock %}
</body>

</html>
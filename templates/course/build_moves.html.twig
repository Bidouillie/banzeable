<turbo-stream action="update" target="course_build-moves_{{ course.id }}">
    <template>
        <h2>{% if my_turn %}Choose your next move{% else %}Choose a move to prepare for{% endif %}</h2>
        <div class="list-group">
            {% if save_form %}
            <div class="tw-grid tw-grid-cols-8 tw-gap-7 tw-p-2"  id="course_build-moves_{{ course.id }}_save-variation">
                <div class="tw-col-span-8">
                    {{ form_start(save_form) }}
                    {{ form_end(save_form) }}
                </div>
            </div>
             {% endif %}
            <div class="tw-grid tw-grid-cols-8 tw-gap-7 tw-p-2">
                <div class="tw-col-span-4">Move</div>
                <div class="tw-col-span-2">{% if my_turn %}Masters{% else %}Expected{% endif %}</div>
                <div class="tw-col-span-2">Peer results</div>
            </div>
            {% for move_form in moves_forms %}
                {% set move = move_form.move %}
                {% set form = move_form.form %}
                {% set move_nb_games = my_turn ? move_form.nb_masters_games : move.total %}
                <a href="#" class="list-group-item list-group-item-action build_move {% if not move_form.cover %}disabled{% endif %}" data-san="{{ move.san }}" data-lan="{{ move.LAN }}" onclick="return false">
                    {{ form_start(form) }}
                    <div class="tw-grid tw-grid-cols-8 tw-gap-7">
                        <div class="tw-col-span-4">{{ move.san }}{% if move_form.reached %} ✅{% endif %}{% if move_form.next_move_reached %} ✔{% endif %}</div>
                        <div class="tw-col-span-2">
                            {% if true %}
                                {% if move_nb_games > 0 %}
                                    1 in {{ (nb_games / move_nb_games)|round }} games
                                {% else %}
                                    1 in ∞ games
                                {% endif %}
                            {% else %}
                                {% if move_nb_games >= nb_games / 100 %}
                                    {{ (move_nb_games / nb_games)|format_number(style: 'percent') }}
                                {% elseif move_nb_games >= nb_games / 1000 and move_nb_games > 0 %}
                                    &lt;{{ 0.01|format_number(style: 'percent') }}
                                {% elseif move_nb_games >= nb_games / 10000 and move_nb_games > 0 %}
                                    &lt;1‰
                                {% elseif move_nb_games > 0 %}
                                    &lt;1‱
                                {% else %}
                                    {{ 0|format_number(style: 'percent') }}
                                {% endif %}
                            {% endif %}
                        </div>
                        <div class="tw-col-span-2">
                            <div class="tw-flex tw-flex-row tw-rounded-md tw-overflow-hidden">
                                <div class="text-dark bg-light" style="width:{{ (move.white / move.total)|format_number(style: 'percent') }}">
                                    <small class="tw-px-3 tw-py-1">{{ (move.white / ((move.total)))|format_number(style: 'percent') }}</small>
                                </div>
                                <div class="bg-secondary" style="width:{{ (move.draws / move.total)|format_number(style: 'percent') }}"><div class="tw-px-3 tw-py-1"></div></div>
                                <div class="text-end text-light bg-dark" style="width:{{ (move.black / move.total)|format_number(style: 'percent') }}">
                                    <small class="tw-px-3 tw-py-1">{{ (move.black / move.total)|format_number(style: 'percent') }}</small>
                                </div>
                            </div>
                        </div>
                    </div>
                    {{ form_end(form) }}
                </a>
            {% endfor %}
        </div>
    </template>
</turbo-stream>
<turbo-stream action="update" target="course_build-moves_{{ course.id }}">
    <template>
        <h2>{% if my_turn %}Choose your next move{% else %}Choose a move to prepare for{% endif %}</h2>
        <div class="list-group">
            <div class="tw-grid tw-grid-cols-8 tw-gap-7 tw-p-2">
                <div class="tw-col-span-4">Move</div>
                <div class="tw-col-span-2">Masters popularity</div>
                <div class="tw-col-span-2">Peer results</div>
            </div>
            {% for move_form in moves_forms %}
                {% set move = move_form.move %}
                {% set form = move_form.form %}
                {{ form_start(form) }}
                <a href="#" class="list-group-item list-group-item-action" onclick="this.nextElementSibling.click();return false;">
                    <div class="tw-grid tw-grid-cols-8 tw-gap-7">
                        <div class="tw-col-span-4">{{ move.san }}</div>
                        <div class="tw-col-span-2">
                                {% if move_form.master_games >= master_games / 100 %}
                                    {{ (move_form.master_games / master_games)|format_number(style: 'percent') }}
                                {% elseif move_form.master_games >= master_games / 1000 and move_form.master_games > 0 %}
                                    &lt;{{ 0.01|format_number(style: 'percent') }}
                                {% elseif move_form.master_games > 0 %}
                                    &lt;1‰
                                {% else %}
                                    {{ 0|format_number(style: 'percent') }}
                                {% endif %}
                        </div>
                        <div class="tw-col-span-2">{{ (move.white / ((move.white + move.black + move.draws)))|format_number(style: 'percent') }} win</div>
                    </div>
                </a>
                {{ form_widget(form.action) }}
                {{ form_end(form) }}
            {% endfor %}
        </div>
    </template>
</turbo-frame>
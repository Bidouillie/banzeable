{% extends 'base.html.twig' %}

{% block importmap %}{{ importmap(['app', 'studyboard']) }}{% endblock %}

{% block title %}Hello CourseController!{% endblock %}

{% block body %}

<section class="py-5">
    <div class="container px-3 px-lg-4 mt-5">
        <div class="row">
            <div class="col-md-3">
                <ul class="list-group">
                    {% for variation in course.variations %}
                    <li class="list-group-item d-flex justify-content-between align-items-center {% if variation.id == selected_variation.id %}active{% endif %}">
                        {{ variation.name }}
                        <span class="badge bg-primary rounded-pill">1</span>
                    </li>
                    {% endfor %}
                </ul>
            </div>
            <div class="col-md-9">
                <div class="card mb-1 m-auto">
                    <div id="board" style="width: 400px"></div>
                    <div class="js-variation" data-variation="{{ variation_encoded }}"></div>
                </div>
            </div>
        </div>
    </div>
</section>

{% endblock %}
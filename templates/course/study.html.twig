{% extends 'base.html.twig' %}

{% block importmap %}{{ importmap(['app', 'studyboard']) }}{% endblock %}

{% block title %}Hello CourseController!{% endblock %}

{% block body %}

<section>
    <div class="container px-4 px-lg-5">
        <div class="tw-grid tw-grid-cols-11 tw-gap-7" style="grid-template-rows:80vh">
            <div class="tw-col-span-3">
                <div class="card h-100 text-bg-secondary">
                    <div class="card-body tw-overflow-y-auto">
                        <div class="tw-grid tw-grid-cols-10 tw-gap-3" id="moves">
                            {% for key in selected_variation.moves|keys %}

                            {% if not(key % 2) %}
                            <div class="tw-col-span-2 d-flex align-items-center d-none" data-move-index="{{ key / 2 + 1 }}">
                                {{ ((key + 1) / 2)|round(0, 'ceil') }}.
                            </div>
                            {% endif %}
                            <div class="tw-col-span-4">
                                <button type="button" data-half-move-index="{{ key + 1 }}" class="btn btn-secondary btn-lg btn-normal-case w-100 d-none">
                                    {{ selected_variation.moves[key].notation.text }}
                                </button>
                            </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
            <div class="tw-col-span-5">
                <div class="d-flex flex-column">
                    <div class="card">
                        <div id="board"></div>
                        <div class="js-variation" data-variation="{{ variation_encoded }}"></div>
                    </div>
                    <div class="progress mt-3">
                        <div class="progress-bar progress-bar-striped progress-bar-animated" id="progressBar" style="width:0%"></div>
                    </div>
                </div>
            </div>
            <div class="tw-col-span-3">
                <div class="d-flex flex-row justify-content-around" id="navigation" role="group">
                    <button type="button" class="btn btn-lg btn-secondary" data-action="start"><i class="bi bi-chevron-bar-left" style="font-size:1.5rem"></i></button>
                    <button type="button" class="btn btn-lg btn-secondary" data-action="previous"><i class="bi bi-chevron-left" style="font-size:1.5rem"></i></button>
                    <button type="button" class="btn btn-lg btn-secondary" data-action="next"><i class="bi bi-chevron-right" style="font-size:1.5rem"></i></button>
                    <button type="button" class="btn btn-lg btn-secondary" data-action="end"><i class="bi bi-chevron-bar-right" style="font-size:1.5rem"></i></button>
                </div>
            </div>
            <!--div class="tw-col-span-3">
                <div class="list-group">
                    {% for variation in course.variations %}
                    <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center {% if variation.id == selected_variation.id %}active{% endif %}" href="{{ path('app_study_variation', {id: course.id, id_variation: variation.id}) }}">
                        {{ variation.name }}
                        <span class="badge rounded-pill bg-primary"><i class="bi-alarm" style="font-size: 1rem;"></i></span>
                    </a>
                    {% endfor %}
                </div>
                <i class="bi-alarm"></i>
                <i class="bi-alarm" style="font-size: 2rem; color: cornflowerblue;"></i>
            </div-->
        </div>
    </div>
</section>

{% endblock %}